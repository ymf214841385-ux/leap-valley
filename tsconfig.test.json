{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src/game",
    "outDir": "node_modules/.cache/leap-valley-tests",
    "types": []
  },
  "include": [
    "src/game/const.ts",
    "src/game/levels.ts",
    "src/game/sim.ts",
    "src/game/input.ts",
    "src/game/lifecycle.ts",
    "src/game/motion.ts",
    "src/game/save.ts",
    "src/game/store.ts",
    "src/game/assets.ts",
    "src/game/audio.ts",
    "src/game/render.ts",
    "src/game/game.ts",
    "src/game/gameplay.test.ts",
    "src/game/input.test.ts",
    "src/game/lifecycle.test.ts",
    "src/game/save.test.ts",
    "src/game/game.test.ts"
  ]
}
